# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Baseten: agent LLM (Muse Spark Open, OpenAI-compatible endpoint)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API: Muse Spark (base URL and model id from the Meta API quickstart)
META_API_KEY=
META_API_BASE_URL=
META_MODEL=

# Modal: GPU jobs. Either run `modal token new` once (writes ~/.modal.toml),
# or set both values below.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face: only needed if a checkpoint download is rate-limited or gated.
HF_TOKEN=
