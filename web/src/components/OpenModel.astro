---
// The open-model section: present once the open-model run is exported. A component and not an
// MDX block because Astro renders slot content even when the slot is never shown.
import ResultsChart from "./ResultsChart.astro";
import { hasRun } from "../lib/data";

interface Props {
  run: string;
  against: string;
  family?: string;
}
const { run, against, family = "all" } = Astro.props;
---

{
  hasRun(run) && (
    <>
      <h2 id="open-model">An open model with the same tool</h2>
      <p>
        The same tool, the same world model and the same tasks, with Muse Glimmer, an open model, in
        place of Muse Spark.
      </p>
      <ResultsChart runs={[against, run]} family={family} by="agent" />
    </>
  )
}
