---
// The same task, LLM alone vs LLM + world model, side by side. The default slot is the caption.
import EpisodePlayer from "./EpisodePlayer.astro";

interface Props {
  run: string;
  task: string;
  seed?: number;
}
const { run, task, seed = 0 } = Astro.props;
---

<figure class="compare wide">
  <div class="compare-grid">
    <EpisodePlayer run={run} episode={`${task}__no_tool__s${seed}`} title="LLM alone" compact autoplay />
    <EpisodePlayer run={run} episode={`${task}__wm_tool__s${seed}`} title="LLM + world model" compact autoplay />
  </div>
  {Astro.slots.has("default") && <figcaption class="numbered"><slot /></figcaption>}
</figure>
