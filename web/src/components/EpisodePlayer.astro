---
// Replays one logged episode. `compact` hides the transcript; `autoplay` loops while visible.
// The default slot, if any, is the figure's caption.
import { episodeSrc, run as runOf } from "../lib/data";
import { isBilliards } from "../lib/world";

interface Props {
  run: string;
  episode: string;
  title?: string;
  compact?: boolean;
  autoplay?: boolean;
}
const { run, episode, title, compact = false, autoplay = false } = Astro.props;
const src = episodeSrc(run, episode);
const balls = isBilliards(runOf(run).world);
const object = balls ? "balls" : "T";
const hasCaption = Astro.slots.has("default");
---

<figure
  class:list={["player", { compact }]}
  data-player
  data-episode={src}
  data-compact={compact ? "1" : undefined}
  data-autoplay={autoplay ? "1" : undefined}
>
  {title && <p class="player-title">{title}</p>}
  <div class="player-body">
    <div class="stage">
      <canvas
        role="img"
        aria-label={`The table seen from above: real ${object} filled, goal in green, imagined ${object} in blue, the chosen plan in bright green`}
      ></canvas>
      <p class="thought" data-thought hidden aria-live="polite"></p>
      <p class="caption" data-caption aria-live="polite">Loading…</p>
    </div>
    {!compact && <ol class="transcript" data-transcript aria-label="What the agent did"></ol>}
  </div>
  <div class="controls">
    {!compact && <button type="button" data-prev aria-label="Previous step">‹</button>}
    <button type="button" data-play aria-label="Play">▶</button>
    {
      !compact && (
        <>
          <button type="button" data-next aria-label="Next step">›</button>
          <input type="range" min="0" value="0" data-slider aria-label="Step" />
          <span class="counter" data-counter />
          <label class="toggle">
            <input type="checkbox" data-truth checked /> show the real outcome
          </label>
        </>
      )
    }
  </div>
  {
    !compact && (
      <ul class="legend">
        {balls ? (
          <>
            <li><i class="k-white" />white ball</li>
            <li><i class="k-red" />red ball</li>
            <li><i class="k-goal round" />goal for the red ball</li>
          </>
        ) : (
          <>
            <li><i class="k-real" />real T</li>
            <li><i class="k-goal" />goal</li>
          </>
        )}
        <li><i class="k-ghost" />imagined</li>
        <li><i class="k-chosen" />the plan it picks</li>
        <li><i class="k-truth" />where it really goes</li>
        <li><i class="k-pusher" />{balls ? "cue tip" : "pusher"}</li>
      </ul>
    )
  }
  {hasCaption && <figcaption class="numbered"><slot /></figcaption>}
</figure>

<script>
  import { mountPlayers } from "../lib/player";
  mountPlayers();
</script>
